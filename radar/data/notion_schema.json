 "levels": {
  "row": "缺失或非法 → 该行隔离（quarantine）：有上次成功版本则沿用并标「待更新」，没有则不显示",
  "judgment": "缺失或不满足 judgment_rule → 照常显示，但标「待更新」并给出 reasons",
  "evidence": "决定财报证据等级（有原文 / 部分 / 缺来源）",
  "optional": "可空；格式不对 → 置空 + warning",
  "ignore": "程序不读（Notion 公式仅供人看）"
 },
 "judgment_rule": {
  "ai_when_all": [
   "研判理由 非空",
   "来源 至少 1 个 http(s) URL",
   "研判日期 ≤ today",
   "有效至 ≥ today",
   "有效至 − 研判日期 ≤ 14 天",
   "本行 AI 文本无禁用词"
  ],
  "reasons": [
   "missing_reason",
   "missing_source",
   "missing_dates",
   "future_judgment_date",
   "expired",
   "validity_too_long",
   "banned_words",
   "row_quarantined",
   "not_current_week"
  ],
  "today": "build 的 fixedClock 换算到 Asia/Shanghai 的日期"
 },
 "text_rules": {
  "concat": "所有 rich_text/title 片段的 plain_text 直接拼接，再 strip；不读 annotations",
  "urls": "正则 https?://[^\\s<>\"'）)]+ 从拼接文本中提取，去重保序",
  "tokens": "{{earnings:代号}}：代号不存在或已停用 → warning token_unknown_company；DATA 保留原始 token，页面渲染为「日期待定」",
  "soft_len": "超过 → warning text_long（不截断）",
  "hard_len": "超过 → 按单位累加（普通字符 1、token 10），累计放不下 hard_len−1 时停止，末尾加 “…”；截断点落在 token 内则整个 token 去掉；warning text_truncated",
  "length_unit": "len() of Python str（按 Unicode 码位）",
  "token_len": "计算 soft_len/hard_len 时，每个 {{earnings:代号}} 按 10 个字计（≈“10/31 · 预估”）",
  "banned_match": "先 unicodedata.normalize(\"NFKC\")，再删除所有空白（\\s 与 U+3000），然后做子串匹配；命中 → 该字段置空 + warning banned_words（研判表同时 reasons 加 banned_words；每日/每周行整行作废）"
 },
